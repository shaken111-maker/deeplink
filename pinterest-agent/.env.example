# Pinterest (https://developers.pinterest.com/apps/)
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_REFRESH_TOKEN=
PINTEREST_REDIRECT_URI=https://go.tengry.store/oauth
# доска по умолчанию; узнать id: python agent.py --boards
PINTEREST_BOARD_ID=

# ИИ-копирайтер (необязательно: без ключа берётся текст из очереди)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Поведение агента
POSTS_PER_RUN=3
PAUSE_SECONDS=20
CONTENT_LANGUAGE=ru
# ссылки в пинах заворачиваются в деплинк этого репозитория
DEEPLINK_BASE=https://go.tengry.store
DRY_RUN=
